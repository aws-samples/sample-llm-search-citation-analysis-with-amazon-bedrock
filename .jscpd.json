{
  "minTokens": 25,
  "minLines": 3,
  "mode": "weak",
  "crossFormats": "typescript,tsx",
  "baseline": ".jscpd-baseline/typescript.json",
  "failOnNewClones": 0,
  "gitignore": true,
  "format": ["typescript", "tsx"],
  "reporters": ["console"],
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/cdk.out/**",
    "**/coverage/**",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*-fixtures.ts",
    "**/*-fixtures.tsx"
  ]
}
