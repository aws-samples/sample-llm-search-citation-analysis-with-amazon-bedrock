{
  "minTokens": 25,
  "minLines": 3,
  "mode": "weak",
  "baseline": ".jscpd-baseline/python.json",
  "failOnNewClones": 0,
  "gitignore": true,
  "format": [
    "python"
  ],
  "reporters": [
    "console"
  ],
  "ignore": [
    "**/node_modules/**",
    "**/layer/python/**",
    "**/crawler-layer/python/**",
    "**/.deps/**",
    "**/__pycache__/**",
    "**/test_*.py",
    "**/conftest.py"
  ]
}
