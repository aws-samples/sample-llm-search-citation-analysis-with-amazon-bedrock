{
  "minTokens": 25,
  "minLines": 3,
  "mode": "weak",
  "baseline": ".jscpd-baseline/python-tests.json",
  "failOnNewClones": 0,
  "gitignore": true,
  "format": [
    "python"
  ],
  "reporters": [
    "console"
  ],
  "pattern": "**/{test_*,conftest}.py",
  "ignore": [
    "**/node_modules/**",
    "**/layer/python/**",
    "**/crawler-layer/python/**",
    "**/.deps/**",
    "**/__pycache__/**"
  ]
}
