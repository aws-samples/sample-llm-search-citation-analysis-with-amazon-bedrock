{
  "minTokens": 40,
  "threshold": 0,
  "gitignore": true,
  "format": [
    "python"
  ],
  "reporters": [
    "console"
  ],
  "pattern": "**/{test_*,conftest}.py",
  "ignore": [
    "**/node_modules/**",
    "**/layer/python/**",
    "**/crawler-layer/python/**",
    "**/.deps/**",
    "**/__pycache__/**"
  ]
}
