{
  "minTokens": 25,
  "minLines": 3,
  "mode": "weak",
  "ignorePattern": [
    "(?m)^[ \\t]*import\\b[^;]*?\\bfrom[ \\t]*['\"][^'\"\\n]+['\"][ \\t]*;",
    "(?m)^[ \\t]*import[ \\t]*['\"][^'\"\\n]+['\"][ \\t]*;",
    "(?m)^[ \\t]*export[ \\t]+(type[ \\t]+)?(\\*|\\*[ \\t]+as[ \\t]+\\w+|\\{[^}]*\\})[ \\t]*from[ \\t]*['\"][^'\"\\n]+['\"][ \\t]*;"
  ],
  "crossFormats": "typescript,tsx",
  "baseline": ".jscpd-baseline/typescript-tests.json",
  "failOnNewClones": 0,
  "gitignore": true,
  "format": ["typescript", "tsx"],
  "reporters": ["console"],
  "pattern": "**/*{.spec,-fixtures}.{ts,tsx}",
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/cdk.out/**",
    "**/coverage/**"
  ]
}
