{
  "name": "citation-pr-reviewer",
  "description": "Read-only pull request reviewer: checks a diff against TENETS.md, README.md and CONTRIBUTING.md and writes one review comment.",
  "prompt": "file://./citation-pr-reviewer.prompt.md",
  "tools": ["read_file", "list_directory", "file_search", "grep_search"],
  "excludedTools": ["knowledge", "code", "introspect", "invoke_sub_agent", "disclose_context"],
  "includeMcpJson": false,
  "mcpServers": {},
  "resources": [],
  "permissions": {
    "rules": [
      {
        "capability": "fs_read",
        "match": ["__REVIEW_ROOT__/**"],
        "exclude": ["__REVIEW_ROOT__/pr/.git/**", "__REVIEW_ROOT__/**/.env", "__REVIEW_ROOT__/**/.env.*"],
        "effect": "allow"
      },
      {
        "capability": "fs_read",
        "match": ["/**"],
        "exclude": ["__REVIEW_ROOT__/**"],
        "effect": "deny"
      },
      { "capability": "fs_read", "match": ["**/.git/**", "**/.env", "**/.env.*"], "effect": "deny" },
      { "capability": "fs_write", "effect": "deny" },
      { "capability": "shell", "effect": "deny" },
      { "capability": "web_fetch", "effect": "deny" },
      { "capability": "web_search", "effect": "deny" },
      { "capability": "mcp", "effect": "deny" },
      { "capability": "subagent", "effect": "deny" },
      { "capability": "skill", "effect": "deny" },
      { "capability": "power", "effect": "deny" }
    ]
  }
}
