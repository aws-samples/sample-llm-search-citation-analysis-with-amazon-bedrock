{
  "name": "citation-analysis-system",
  "version": "2.43.1",
  "description": "Serverless citation analysis system using AWS CDK",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "lint": "npx eslint .",
    "lint:fix": "npx eslint . --fix",
    "duplication": "jscpd bin lib web/src",
    "duplication:tests": "jscpd --config .jscpd.tests.json bin lib web/src",
    "duplication:baseline": "jscpd --update-baseline bin lib web/src && jscpd --config .jscpd.tests.json --update-baseline bin lib web/src && jscpd --config .jscpd.python.json --update-baseline lambda scripts && jscpd --config .jscpd.python-tests.json --update-baseline lambda",
    "deadcode": "knip",
    "deadcode:prod": "knip --production --strict",
    "contracts": "bash scripts/check-contracts.sh",
    "mutation:python": "bash scripts/mutate-python.sh",
    "validate": "bash scripts/validate.sh",
    "validate:failed": "bash scripts/validate.sh --failed",
    "validate:list": "bash scripts/validate.sh --list",
    "validate:help": "bash scripts/validate.sh --help",
    "quality:codeql": "bash scripts/codeql-local.sh",
    "validate:web": "bash scripts/validate.sh --only web",
    "validate:python": "bash scripts/validate.sh --only python",
    "deps:audit": "node scripts/dependency-audit.mjs",
    "hooks:install": "bash scripts/install-git-hooks.sh",
    "prepare": "bash scripts/install-git-hooks.sh",
    "cdk": "cdk",
    "deploy": "./scripts/deploy.sh",
    "deploy:cdk": "cdk deploy --all --require-approval never",
    "deploy:full": "npm run deploy:cdk && npm run clear-cache",
    "clear-cache": "bash scripts/clear-cloudfront-cache.sh",
    "synth": "cdk synth",
    "test": "vitest run",
    "e2e:users": ".venv/bin/python scripts/e2e_user_invites.py",
    "e2e:seo": ".venv/bin/python scripts/e2e_seo.py",
    "e2e": "npm run e2e:seo && npm run e2e:users"
  },
  "keywords": [
    "cdk",
    "aws",
    "citation-analysis"
  ],
  "author": "",
  "license": "MIT-0",
  "engines": {
    "node": ">=24 <25"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@nx/eslint-plugin": "^23.3.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.19.2",
    "@vitest/eslint-plugin": "^1.6.13",
    "aws-cdk": "^2.1148.0",
    "eslint": "^9.39.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-sonarjs": "^3.0.5",
    "eslint-plugin-unicorn": "^62.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jscpd": "5.4.2",
    "knip": "6.44.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.275.0",
    "constructs": "^10.6.0"
  },
  "overrides": {
    "diff": "^8.0.3",
    "flatted": "^3.4.2",
    "yaml@^1.0.0": "^1.10.3",
    "picomatch": "^4.0.4",
    "brace-expansion": "^5.0.12",
    "minimatch": "^11.0.1",
    "axios": "^1.20.0",
    "follow-redirects": "^1.16.0",
    "smol-toml@<1.9.0": "1.9.0",
    "source-map-js@<1.2.2": "1.2.2",
    "undici@>=7.0.0 <7.30.1": "7.30.2",
    "zod@<4.6.6": "4.6.7"
  }
}
